# Client-safe (embedded in the browser bundle)
# VITE_GOOGLE_MAPS_API_KEY=

# Server-only: used by Vite dev middleware at POST /api/chat — never use VITE_ prefix for secrets
# Create a new key at https://platform.openai.com/api-keys — do not commit real values
# OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# If set, the chat widget POSTs here instead of same-origin /api/chat (e.g. production Worker)
# VITE_ASSISTANT_API_URL=https://your-api.example.com
